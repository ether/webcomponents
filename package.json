    "@vitest/browser": "^4.1.3",
    "@vitest/browser-playwright": "^4.1.3",
    "@vitest/runner": "^4.1.3",
    "playwright": "^1.59.1",
    "storybook": "^10.3.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
